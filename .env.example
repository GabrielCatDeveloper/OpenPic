# ==========================================================================
# openPic — configuracion local
#
# Copia este fichero a .env y rellena los valores.  NO subas .env a git
# (ya esta en .gitignore).
# ==========================================================================

# --- Tokens de Telegram ---------------------------------------------------
# 1) Bot PUBLICO: el que usan los usuarios finales para analizar su comida.
#    Habla con @BotFather -> /newbot -> te da un token con este formato:
#    123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_BOT_TOKEN=PUT_PUBLIC_TOKEN_AQUI

# @usuario del bot publico (sin la @). Permite que el panel de tokens ofrezca
# un boton "Entrar" con el token ya dentro (deep link: t.me/<usuario>?start=...)
PUBLIC_BOT_USERNAME=mi_bot_de_nutricion

# 2) Bot PRIVADO (gate): el que emite los tokens de acceso. Debe ser OTRO bot
#    distinto del publico. Tambien se pide a @BotFather.
GATE_BOT_TOKEN=PUT_GATE_TOKEN_AQUI

# Tu id numerico de Telegram: escribe /start al @userinfobot y te lo dice.
# En SINGLE_USER_MODE solo se usa el PRIMER id: ese eres tu, el propietario.
ADMIN_TELEGRAM_IDS=123456789

# --- Acceso ---------------------------------------------------------------
# true  -> el panel que genera tokens (bot privado) solo lo usa el
#          propietario; el resto recibe "este es un bot de un solo usuario".
#          El bot publico sigue abierto para quien tenga un token valido.
# false -> el panel lo puede usar cualquiera de ADMIN_TELEGRAM_IDS.
SINGLE_USER_MODE=true

# Plan con el que se activa tu cuenta en el bot publico (no hace falta token).
OWNER_PLAN=unlimited

# --- Motor de inferencia (Food-R1) ----------------------------------------
# openai_compat -> llama-server (recomendado) | ollama | mock (pruebas)
LLM_PROVIDER=openai_compat
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=sk-local
LLM_MODEL=food-r1
LLM_TIMEOUT=300
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.1

# JSON extra que se envia en cada peticion (opcional).
# Ejemplo: {"cache_prompt": true}
LLM_EXTRA_BODY=

# Inferencias simultaneas contra el motor. Ponlo a 1 si el servidor de
# llama.cpp va con --parallel 1 (es lo recomendado en una iGPU: una foto
# cada vez y sin que se quede sin memoria).
LLM_CONCURRENCY=1

# --- Privacidad -----------------------------------------------------------
# Zona horaria para agrupar las comidas por dia (nombre IANA).
# Determina cuando empieza "hoy" para los usuarios.
TIMEZONE=Europe/Madrid

# Si es true (por defecto) la foto se guarda en PHOTOS_DIR mientras se analiza
# y se borra en cuanto se envia el resultado. Si el bot se cae a mitad del
# analisis, PHOTO_TTL_HOURS y la limpieza periodica la recogen.
# Ponlo en false para que las fotos vivan solo en memoria.
STORE_PHOTOS=true
PHOTO_TTL_HOURS=1

# Permitir que alguien se registre sin token (plan free). En un bot con
# acceso restringido déjalo en false.
ALLOW_SELF_SIGNUP=false

# --- Rutas ----------------------------------------------------------------
DB_PATH=data/foodbot.db
PHOTOS_DIR=data/photos
MODELS_DIR=models
LOGS_DIR=logs

# Limite de tamaño de foto aceptado (MB).
MAX_PHOTO_MB=12
